# Shared secret; must match RUNNER_SECRET in bot-orchestrator. Generate with:
#   openssl rand -hex 32
RUNNER_SECRET=

# Local Telegram Bot API server.
BOT_API_URL=http://telegram-bot-api:8081

# Orchestrator base URL, used by ctx.kv.
ORCHESTRATOR_URL=http://bot-orchestrator:8000

# Root folder for bot files; each bot writes to <FILES_ROOT>/<bot id>.
FILES_ROOT=/files

# Data directory of the local Bot API server; must be the same path in every container.
BOT_API_DATA_DIR=/var/lib/telegram-bot-api

# Hard time limit for one handler call, in seconds.
HANDLER_TIMEOUT=60

# Hard time limit for one background task, in seconds.
TASK_TIMEOUT=3600

# Address-space limit for one handler process, in MB (0 disables the limit).
HANDLER_MEMORY_MB=1024

# Maximum number of handler processes running at the same time.
MAX_CONCURRENT_RUNS=8

# Maximum number of background tasks running at the same time.
MAX_CONCURRENT_TASKS=2

# Read-only folder handlers may read, e.g. cookies for ctx.download(cookies=...).
SHARED_READ_DIR=/shared

# Persistent folder for extra Python packages installed from the orchestrator.
PACKAGES_DIR=/packages

# Environment variables for handlers: BOTENV_<NAME>=value is passed to every handler,
# background task and ctx.shell program as <NAME>=value (prefix removed). Read once at
# start. PATH, PYTHON*, LD_* and runner setting names are skipped. Example:
# BOTENV_WEATHER_API_URL=https://api.example.com
